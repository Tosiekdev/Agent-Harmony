@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/AgentHarmonyTargets.cmake")
if("visualization" IN_LIST AgentHarmony_FIND_COMPONENTS)
    if(NOT @AGENT_HARMONY_BUILD_VISUALIZATION@)
        set(AgentHarmony_FOUND FALSE)
        set(AgentHarmony_NOT_FOUND_MESSAGE "This installation does not contain the visualization component")
        return()
    endif()
    find_dependency(SFML 3 CONFIG COMPONENTS Graphics Window System)
    include("${CMAKE_CURRENT_LIST_DIR}/AgentHarmonyVisualizationTargets.cmake")
    set(AgentHarmony_visualization_FOUND TRUE)
endif()
set(AgentHarmony_core_FOUND TRUE)
check_required_components(AgentHarmony)

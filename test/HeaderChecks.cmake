file(GLOB_RECURSE public_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../include/*.hpp")
set(header_sources "")
foreach(header IN LISTS public_headers)
    if(header MATCHES "Impl.hpp$" OR (header MATCHES "/experimental/" AND NOT AGENT_HARMONY_BUILD_VISUALIZATION))
        continue()
    endif()
    file(RELATIVE_PATH relative "${CMAKE_CURRENT_SOURCE_DIR}/../include" "${header}")
    string(MAKE_C_IDENTIFIER "${relative}" id)
    set(source "${CMAKE_CURRENT_BINARY_DIR}/headers/${id}.cpp")
    file(WRITE "${source}" "#include <${relative}>\n")
    list(APPEND header_sources "${source}")
endforeach()
add_library(header_checks OBJECT ${header_sources})
target_link_libraries(header_checks PRIVATE AgentHarmony::core)
if(AGENT_HARMONY_BUILD_VISUALIZATION)
    target_link_libraries(header_checks PRIVATE AgentHarmony::visualization)
endif()
